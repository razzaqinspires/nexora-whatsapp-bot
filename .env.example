# NEXORA BOT v15
BOT_PREFIX=/
BOT_PREFIX_MODE=multi
BOT_ACCESS_MODE=public
AUTH_MODE=qr
PAIRING_PHONE=
AUTH_DIR=./auth
OWNER_JIDS=628xxxxxxxxxx@s.whatsapp.net
ADMIN_JIDS=
BLOCK_JIDS=
ALLOW_GROUPS=true
ALLOW_PRIVATE=true
ALLOW_SELF_COMMANDS=true
MAINTENANCE_MODE=false
AUDIT_LOG=true
RATE_LIMIT_MAX=15
PREMIUM_RATE_LIMIT_MAX=40
RATE_LIMIT_WINDOW_MS=10000
COMMAND_COOLDOWN_MS=500
MAX_COMMAND_LENGTH=4000

RECONNECT_ENABLED=true
RECONNECT_INITIAL_DELAY_MS=3000
RECONNECT_MAX_DELAY_MS=60000
RECONNECT_MAX_ATTEMPTS=20

NEXORA_TIMEZONE=Asia/Jakarta
NEXORA_SLOTS=09:00,13:00,19:00
NEXORA_AUTOUPLOAD=false
NEXORA_MAX_DAILY_POSTS=3
NEXORA_JOB_RETRIES=3
NEXORA_JOB_COOLDOWN_MIN=5

# AI ROUTER - pilih salah satu format.
# Format 1: JSON array multi-provider.
# AI_PROVIDERS_JSON=[{"id":"openai-1","name":"OpenAI Primary","apiKey":"KEY_1","baseUrl":"https://api.openai.com/v1","model":"YOUR_MODEL_ID","apiMode":"responses","priority":1,"weight":5,"rpm":0,"tpm":0},{"id":"openai-2","name":"OpenAI Backup","apiKey":"KEY_2","baseUrl":"https://api.openai.com/v1","model":"YOUR_MODEL_ID","apiMode":"responses","priority":2,"weight":3}]
# Format 2: AI_API_1_* sampai AI_API_12_*.
AI_API_1_NAME=OpenAI Primary
AI_API_1_KEY=
AI_API_1_BASE_URL=https://api.openai.com/v1
AI_API_1_MODEL=YOUR_MODEL_ID
AI_API_1_MODE=responses
AI_API_1_PRIORITY=1
AI_API_1_WEIGHT=5
AI_API_1_RPM=0
AI_API_1_TPM=0
AI_API_1_ENABLED=true
AI_API_2_NAME=Backup Provider
AI_API_2_KEY=
AI_API_2_BASE_URL=
AI_API_2_MODEL=
AI_API_2_MODE=responses
AI_API_2_PRIORITY=2
AI_API_2_WEIGHT=3
AI_API_2_RPM=0
AI_API_2_TPM=0
AI_API_2_ENABLED=true
AI_API_MODE=responses
AI_TIMEOUT_MS=30000
AI_TEMPERATURE=0.7
AI_RETRIES=1
AI_PROVIDER_COOLDOWN_MS=30000
AI_MAX_CONTEXT=12

# Instagram. LIVE hanya jika kedua flag ini benar.
IG_USERNAME=
IG_PASSWORD=
IG_SESSION_FILE=./auth/instagram-session.json
IG_PUBLISH_ENABLED=false
DRY_RUN=true
KEEP_MANUAL_MEDIA=false

# Downloader: install yt-dlp + ffmpeg di server.
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg
DOWNLOAD_MAX_MB=80
DOWNLOAD_TIMEOUT_MS=120000
DOWNLOAD_TEMP_DIR=./downloads

GAME_DAILY_XP_CAP=1000

# WhatsApp quick-button UI
BUTTONS_ENABLED=true

# RPG
GAME_BATTLE_TIMEOUT_MS=300000
GAME_MAX_BATTLE_LOG=30

# V14 Smart cache + persistent JSONL memory
NEXORA_CACHE_DIR=./data/cache
NEXORA_CACHE_MAX=500
NEXORA_CACHE_TTL_MS=86400000
NEXORA_MEMORY_DIR=./data/memory
NEXORA_MEMORY_COMPACT_EVERY=5000

# Live runtime website / rich-card metadata
NEXORA_WEB_HOST=0.0.0.0
NEXORA_WEB_PORT=3000
# Set this to a public HTTPS URL (Cloudflare Tunnel/ngrok/reverse proxy) for WhatsApp live link previews
NEXORA_PUBLIC_URL=
# Optional Python executable used for automatic yt-dlp installation
PYTHON_BIN=
