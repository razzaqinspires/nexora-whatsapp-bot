# WhatsApp
BOT_PREFIX=/
AUTH_DIR=./session/whatsapp
# qr | pairing
AUTH_MODE=qr
PAIRING_PHONE=
OWNER_JIDS=

# Security
ALLOW_GROUPS=true
ALLOW_PRIVATE=true
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX=8
COMMAND_COOLDOWN_MS=1200
LOG_LEVEL=info
AUDIT_LOG=true
BLOCKED_JIDS=

# NEXORA automation
NEXORA_TIMEZONE=Asia/Jakarta
NEXORA_SLOTS=09:00,13:00,19:00
NEXORA_AUTOUPLOAD=false
MAX_DAILY_POSTS=3
DRY_RUN=true

# Optional AI provider
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Instagram private adapter (optional; no Facebook Graph API)
IG_USERNAME=
IG_PASSWORD=
IG_AUTO_LOGIN=false
IG_SESSION_FILE=./data/instagram-session.json

# Behavior
AUTO_RECONNECT=true
RECONNECT_DELAY_MS=3000
MAX_RECONNECT_DELAY_MS=30000
